name: Deliver Go application

on:
  workflow_call:
    inputs:
      app:
        required: true
        type: string
      environment:
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: nortezh-${{ inputs.app }}-${{ inputs.environment }}
  cancel-in-progress: false

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Validate selected application
        shell: bash
        env:
          APP: ${{ inputs.app }}
          STAGE: ${{ inputs.environment }}
        run: |
          set -euo pipefail
          [[ "$APP" =~ ^[a-z][a-z0-9-]*$ ]]
          [[ "$STAGE" == staging || "$STAGE" == production ]]
          test -f "cmd/$APP/main.go"
          test -f "build/$APP/Dockerfile"
          test -f .dockerignore
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
          cache: true
      - name: Verify source with isolated database tests
        shell: bash
        env:
          TEST_DB_MODE: embedded
        run: |
          set -euo pipefail
          go mod download
          go build ./...
          go vet ./...
          go test -p 4 ./...

  publish:
    needs: verify
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
      packages: write
    outputs:
      image: ${{ steps.image.outputs.tag }}
      digest: ${{ steps.build.outputs.digest }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3
      - uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Select traceable image reference
        id: image
        shell: bash
        env:
          APP: ${{ inputs.app }}
          STAGE: ${{ inputs.environment }}
        run: |
          set -euo pipefail
          image="ghcr.io/${GITHUB_REPOSITORY,,}/$APP-$STAGE"
          printf 'tag=%s:%s-%s-%s\n' "$image" "$GITHUB_SHA" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" >> "$GITHUB_OUTPUT"
      - name: Build and publish
        id: build
        uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6
        with:
          context: .
          file: build/${{ inputs.app }}/Dockerfile
          platforms: linux/amd64
          pull: true
          push: true
          tags: ${{ steps.image.outputs.tag }}
          cache-from: type=gha,scope=${{ inputs.app }}-${{ inputs.environment }}-amd64
          cache-to: type=gha,mode=max,scope=${{ inputs.app }}-${{ inputs.environment }}-amd64
      - name: Record image identity
        shell: bash
        env:
          IMAGE: ${{ steps.image.outputs.tag }}
          DIGEST: ${{ steps.build.outputs.digest }}
        run: |
          set -euo pipefail
          test -n "$DIGEST"
          printf 'Published %s\nDigest %s\n' "$IMAGE" "$DIGEST" >> "$GITHUB_STEP_SUMMARY"

  deploy:
    needs: publish
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions: {}
    environment: ${{ format('{0}-{1}', inputs.app, inputs.environment) }}
    steps:
      - name: Validate Nortezh target configuration
        shell: bash
        env:
          NTZ_PROJECT: ${{ vars.NTZ_PROJECT }}
          NTZ_LOCATION: ${{ vars.NTZ_LOCATION }}
          NTZ_DEPLOYMENT: ${{ vars.NTZ_DEPLOYMENT }}
          NTZ_TYPE: ${{ vars.NTZ_TYPE }}
          NTZ_PORT: ${{ vars.NTZ_PORT }}
        run: |
          set -euo pipefail
          test -n "$NTZ_PROJECT"
          test -n "$NTZ_LOCATION"
          test -n "$NTZ_DEPLOYMENT"
          [[ "$NTZ_TYPE" == WebService || "$NTZ_TYPE" == Worker ]]
          if [[ "$NTZ_TYPE" == WebService ]]; then
            [[ "$NTZ_PORT" =~ ^[1-9][0-9]{0,4}$ ]]
            (( NTZ_PORT <= 65535 ))
          fi
      - name: Create WebService revision
        if: vars.NTZ_TYPE == 'WebService'
        uses: Nortezh/nortezh-action@ec5808f79fa5cfc74514e8631a0013315a79475f # v1.0.5
        with:
          action: deployment.create-revision
          project: ${{ vars.NTZ_PROJECT }}
          location: ${{ vars.NTZ_LOCATION }}
          name: ${{ vars.NTZ_DEPLOYMENT }}
          image: ${{ needs.publish.outputs.image }}
          type: WebService
          port: ${{ vars.NTZ_PORT }}
        env:
          SA_AUTH_EMAIL: ${{ secrets.NTZ_SA_EMAIL }}
          SA_AUTH_KEY: ${{ secrets.NTZ_SA_KEY }}
      - name: Create Worker revision
        if: vars.NTZ_TYPE == 'Worker'
        uses: Nortezh/nortezh-action@ec5808f79fa5cfc74514e8631a0013315a79475f # v1.0.5
        with:
          action: deployment.create-revision
          project: ${{ vars.NTZ_PROJECT }}
          location: ${{ vars.NTZ_LOCATION }}
          name: ${{ vars.NTZ_DEPLOYMENT }}
          image: ${{ needs.publish.outputs.image }}
          type: Worker
        env:
          SA_AUTH_EMAIL: ${{ secrets.NTZ_SA_EMAIL }}
          SA_AUTH_KEY: ${{ secrets.NTZ_SA_KEY }}
