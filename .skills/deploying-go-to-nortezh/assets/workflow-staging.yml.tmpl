name: Deliver __APP__ to staging

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - .github/workflows/__APP__-staging.yml
      - .github/workflows/deliver-go.yml
      - __APP__/**
      - cmd/__APP__/**
      - build/__APP__/**
      - pkg/**
      - schema/**
      - go.mod
      - go.sum
      - .dockerignore
      # Add application-specific runtime assets and other shared dependencies.

permissions:
  contents: read
  packages: write

jobs:
  deliver:
    uses: ./.github/workflows/deliver-go.yml
    with:
      app: __APP__
      environment: staging
