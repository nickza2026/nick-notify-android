# Documentation only. Do NOT apply this file or commit actual secret values.
# Prefer kubectl create secret generic --from-file as described in the Thai docs.
apiVersion: v1
kind: Secret
metadata:
  name: notify-alarm-secrets
  namespace: notify-alarm
type: Opaque
stringData:
  ALERT_API_KEY: "<random-secret-at-least-32-bytes>"
  FCM_DEVICE_TOKEN: "<current-Pixel-FCM-registration-token>"
  service-account.json: "<complete-service-account-JSON-from-private-file>"
