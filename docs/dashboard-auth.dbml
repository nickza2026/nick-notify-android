// Editable, local implementation diagram; ready for team review, not evidence
// of production DDL or permission to upload schema/data to an external service.
Project notify_dashboard {
  database_type: 'PostgreSQL'
  Note: 'One installation-wide owner. Login does not create tenant ownership for historical alerts. No public signup. Hash fields are schema names only, never actual credentials.'
}

Table alerts {
  id text [pk]
  idempotency_hash bytea [not null, unique]
  body_hash bytea [not null]
  title text [not null]
  message text [not null]
  importance text [not null, default: 'critical', note: 'CHECK importance IN (normal, critical); stored as text, not a PostgreSQL enum type']
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'Latest start, not a running-alarm stop time']
  capability_hash bytea [note: 'Per-alert mobile Ack capability hash, not browser login']
  outcome text [not null, default: 'delivery_unknown', note: 'CHECK outcome IN (delivery_unknown, provider_accepted, provider_failed)']
  provider_accepted_at timestamptz
  completed_at timestamptz
  failure_code text
  first_ack_at timestamptz

  indexes {
    (created_at, id) [name: 'alerts_page_idx', note: 'Both descending in PostgreSQL']
  }
}

Table ack_actions {
  alert_id text [not null]
  client_action_id uuid [not null, note: 'Stable per human action; may be shared by multiple alerts']
  client_acked_at timestamptz [note: 'Reported device clock, nullable']
  received_at timestamptz [not null, note: 'Server receipt time']

  indexes {
    (alert_id, client_action_id) [pk]
    (alert_id, received_at) [name: 'ack_actions_received_idx']
  }
}

Table dashboard_owner {
  id smallint [pk, note: 'CHECK id = 1 enforces singleton owner']
  username text [not null, note: 'Case-sensitive; bootstrap validates 3-64 ASCII characters']
  password_hash text [not null, note: 'Versioned salted PBKDF2-SHA256, never plaintext']
  bootstrap_hash text [not null, note: 'Retained to disallow reuse of original initial password']
  must_change_password boolean [not null, default: true]
  login_failures integer [not null, default: 0]
  login_window timestamptz
  change_failures integer [not null, default: 0]
  change_window timestamptz
}

Table dashboard_sessions {
  token_hash bytea [pk, note: 'CHECK length = 32; SHA256 of random opaque token']
  owner_id smallint [not null]
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'Absolute 24-hour expiry; up to 10 sessions retained']

  indexes {
    expires_at [name: 'dashboard_sessions_expiry_idx']
  }
}

Ref: ack_actions.alert_id > alerts.id
Ref: dashboard_sessions.owner_id > dashboard_owner.id

// Shared-account device extension: editable local implementation diagram.
// Team/physical-device acceptance and production migration remain separate.
Table client_keys {
  key_id text [pk, note: 'Only primary currently; public identifier, never application API key material']
  owner_id smallint [not null]
  name text [not null]
  managed boolean [not null, default: false, note: 'Durable registry routing; zero active devices must never restore legacy fallback']
}

Table client_devices {
  id uuid [pk]
  owner_id smallint [not null]
  installation_id uuid [not null, unique, note: 'App installation identity, not hardware ID; legacy import can be adopted once']
  device_name text [not null]
  active boolean [not null, default: false]
  legacy_import boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table client_subscriptions {
  device_id uuid [not null]
  key_id text [not null]
  token_hash bytea [not null, unique]
  token_cipher bytea [not null, note: 'AES-GCM; stable independent external encryption key, no plaintext token']

  indexes {
    (device_id, key_id) [pk]
  }
}

Table client_sessions {
  token_hash bytea [pk, note: 'Hash only; separate from Dashboard cookie and application API key']
  owner_id smallint [not null]
  installation_id uuid [not null, note: 'Login can precede device registration, so intentionally not a device FK']
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: '30-day idle lifetime renewed by successful registration']

  indexes {
    installation_id
  }
}

Table device_deliveries {
  alert_id text [not null]
  device_id uuid [not null]
  device_name text [not null, note: 'Historical snapshot, not a claim of human identity']
  token_hash bytea [not null, note: 'Snapshot guards cleanup against a later token refresh']
  capability_hash bytea [not null, unique, note: 'Per-alert-device Ack capability; never plaintext']
  outcome text [not null, default: 'delivery_unknown']
  failure_code text
  provider_accepted_at timestamptz
  completed_at timestamptz
  first_ack_at timestamptz

  indexes {
    (alert_id, device_id) [pk]
  }
}

Table device_ack_actions {
  alert_id text [not null]
  device_id uuid [not null]
  client_action_id uuid [not null, note: 'Same human Ack-all action may span alerts; statistics dedup device+action']
  client_acked_at timestamptz
  received_at timestamptz [not null]

  indexes {
    (alert_id, device_id, client_action_id) [pk]
    (alert_id, received_at)
  }
}

Ref: client_keys.owner_id > dashboard_owner.id
Ref: client_devices.owner_id > dashboard_owner.id
Ref: client_subscriptions.device_id > client_devices.id
Ref: client_subscriptions.key_id > client_keys.key_id
Ref: client_sessions.owner_id > dashboard_owner.id
Ref: device_deliveries.alert_id > alerts.id
Ref: device_deliveries.device_id > client_devices.id
Ref: device_ack_actions.(alert_id, device_id) > device_deliveries.(alert_id, device_id)
