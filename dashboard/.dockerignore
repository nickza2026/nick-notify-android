# Build with context dashboard/, never the repository root containing Firebase files.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!next.config.ts
!next-env.d.ts
!tsconfig.json
!app/
!app/**
!lib/
!lib/**
!public/
!public/**

# Defence in depth if the source allowlist expands.
**/.env
**/.env.*
**/node_modules
**/.next
**/.git
**/.letta
**/*secret*
**/*credential*
**/*service-account*
**/google-services.json
**/device-token.txt
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
