# Synthetic localhost demo ONLY. This is not a production credential.
# Matches the explicit Go cmd/dev --synthetic fallback; never expose it externally.
BACKEND_URL=http://127.0.0.1:8791
BACKEND_API_KEY=synthetic_demo_api_key_not_for_production_0001
DASHBOARD_PUBLIC_URL=http://127.0.0.1:3010
BACKEND_ALLOWED_HTTP_ORIGINS=
DASHBOARD_DEMO_MODE=true
NEXT_TELEMETRY_DISABLED=1
# For a real runtime, remove the demo key and use BACKEND_API_KEY_FILE instead.
# Never use NEXT_PUBLIC_ for credentials.
# Go cmd/dev also needs a privately supplied DASHBOARD_BOOTSTRAP_PASSWORD
# (32-128 UTF-8 bytes) in the API process. Do not put that password in this Web file.
